# ============================================================
# FastSearch —— 仓库忽略规则
# 原则：只提交源码与脚本；本机数据、编译产物、缓存一律排除
# ============================================================

# ---- Rust 编译产物（可由 cargo build 重建）----
target/

# ---- 磁盘索引（本机数据，7 个盘合计约 672MB）----
# 由 fastsearch.exe index <盘符> 在本机生成，属本机数据、不入库；
# 目录位置跟随 exe（开发构建时落在仓库根 index/）
index/
*.fst

# ---- Python 归档目录（legacy/）的缓存与字节码 ----
__pycache__/
*.py[cod]
*.pkl

# ---- 工具/编辑器本地状态 ----
.workbuddy/
.vscode/
.idea/
*.swp
*~

# ---- Windows 系统文件 ----
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
